# .ralphrc - Ralph project configuration
# Active project: GhostFit MVP

# Project identification
PROJECT_NAME="GhostFit MVP"
PROJECT_TYPE="android-kotlin"
PROJECT_ROOT="workspace/ghostfit"

# Claude Code CLI command
CLAUDE_CODE_CMD="claude"

# Loop settings
MAX_CALLS_PER_HOUR=100
CLAUDE_TIMEOUT_MINUTES=15
CLAUDE_OUTPUT_FORMAT="json"

# Tool permissions
# Android/Kotlin project: gradle, adb, git (safe subcommands only)
ALLOWED_TOOLS="Write,Read,Edit,Bash(git add *),Bash(git commit *),Bash(git diff *),Bash(git log *),Bash(git status),Bash(git status *),Bash(git push *),Bash(git pull *),Bash(git fetch *),Bash(git checkout *),Bash(git branch *),Bash(git stash *),Bash(git merge *),Bash(git tag *),Bash(./gradlew *),Bash(gradle *),Bash(mkdir *),Bash(ls *),Bash(cat *)"

# Session management
SESSION_CONTINUITY=true
SESSION_EXPIRY_HOURS=24

# Task sources
TASK_SOURCES="local"
GITHUB_TASK_LABEL="ralph-task"

# Circuit breaker thresholds
CB_NO_PROGRESS_THRESHOLD=3
CB_SAME_ERROR_THRESHOLD=5
CB_OUTPUT_DECLINE_THRESHOLD=70
